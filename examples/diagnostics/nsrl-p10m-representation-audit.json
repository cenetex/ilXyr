    { "name": "label_shuffle_accuracy", "category": "control", "operator": "lte", "threshold": 550000, "unit": "ppm", "required": true },
    { "name": "margin_over_prefix_only", "category": "control", "operator": "gte", "threshold": 150000, "unit": "ppm", "required": true }
  ],
  "decision_table": {
    "stable_signal": {
      "condition": "Every required metric passes on held-out documents and distractor swaps.",
      "interpretation": "The frozen representation carries usable context evidence. A new objective may target output use.",
      "next_allowed": ["objective_successor"]
    },
    "localized_signal": {
      "condition": "The overall metric and all controls pass while a held-out document, seed, or swap metric fails.",
      "interpretation": "Context evidence is present and tied to local document features.",
      "next_allowed": ["representation_successor", "data_review"]
    },
    "insufficient_signal": {
      "condition": "All controls pass and the overall metric fails.",
      "interpretation": "A new output head alone has little support from the frozen state.",
      "next_allowed": ["representation_successor", "stop_line"]
    },
    "invalid_controls": {
      "condition": "Any required control metric fails.",
