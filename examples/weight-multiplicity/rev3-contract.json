    "out_of_range_coverage",
    "per_type_exceptional_results_and_intervals",
    "acr1_integrity_versions_and_repairs",
    "acr2_manifest_and_results",
    "uncertainty_analysis",
    "ilxyr_evidence_records",
    "final_decision_report",
    "negative_result_analysis_if_applicable",
    "integer_model_feasibility_note"
  ],
  "acceptance": {
    "negative_result_accepted": true,
    "scientific_pass_required": false,
    "valid_outcomes": ["pass", "classical_pass_exceptional_hold", "rescope", "stop"]
  },
  "intellectual_property": {
