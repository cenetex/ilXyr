{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilxyr.dev/schemas/aws-execution-status.v1.json",
  "title": "ilXyr AWS execution status v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "provider_instance_id",
    "authorization_ref",
    "job_package_ref",
    "state",
    "updated_at_ms"
  ],
  "properties": {
    "schema": { "const": "ilxyr.aws_execution_status.v1" },
    "provider_instance_id": { "type": "string", "pattern": "^i-[a-f0-9]+$" },
    "authorization_ref": { "$ref": "#/$defs/artifactRef" },
    "job_package_ref": { "$ref": "#/$defs/artifactRef" },
    "state": { "enum": ["pending", "running", "succeeded", "failed"] },
    "updated_at_ms": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "artifactRef": {
      "type": "string",
      "pattern": "^artifact://sha256/[a-f0-9]{64}$"
    }
  }
}
