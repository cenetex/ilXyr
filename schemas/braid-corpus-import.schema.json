{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilxyr.dev/schemas/braid-corpus-import.v1.json",
  "title": "ilxyr Braid corpus import v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "version",
    "source",
    "rights",
    "expected_release_id",
    "expected_manifest_sha256",
    "required_files"
  ],
  "properties": {
    "schema": { "const": "ilxyr.braid_corpus_import.v1" },
    "id": {
      "type": "string",
      "pattern": "^dataset://[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)+$"
    },
    "title": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$",
      "maxLength": 128
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "path"],
      "properties": {
        "repository": { "type": "string", "pattern": "^https://\\S+$" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "path": { "$ref": "#/$defs/portablePath" }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license"],
      "properties": {
        "license": { "type": "string", "minLength": 1 },
        "use_constraints": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "expected_release_id": { "type": "string", "minLength": 1 },
    "expected_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "required_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/portablePath" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "portablePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    }
  }
}
