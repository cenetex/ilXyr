{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cenetex.github.io/ilXyr/schemas/family-manifest.schema.json",
  "title": "ilXyr experiment family manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "contributions",
    "members",
    "run_all",
    "success_outcome",
    "failure_outcome"
  ],
  "properties": {
    "schema": { "const": "ilxyr.family_manifest.v1" },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "contributions": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "members": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/member" }
    },
    "prior_outcomes": {
      "type": "array",
      "items": { "$ref": "#/$defs/priorOutcome" },
      "default": []
    },
    "run_all": { "const": true },
    "success_outcome": { "type": "string", "minLength": 1 },
    "failure_outcome": { "type": "string", "minLength": 1 },
    "promotion_candidate": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "required_outcome",
        "experiment",
        "forecasts",
        "funding"
      ],
      "properties": {
        "seed": { "type": "integer", "minimum": 0 },
        "required_outcome": { "type": "string", "minLength": 1 },
        "experiment": { "type": "string", "minLength": 1 },
        "forecasts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "funding": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "priorOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "experiment_id",
        "seed",
        "resolved_outcome",
        "required_outcome",
        "result_ref"
      ],
      "properties": {
        "experiment_id": { "type": "string", "minLength": 1 },
        "seed": { "type": "integer", "minimum": 0 },
        "resolved_outcome": { "type": "string", "minLength": 1 },
        "required_outcome": { "type": "string", "minLength": 1 },
        "result_ref": {
          "type": "string",
          "pattern": "^artifact://sha256/[0-9a-f]{64}$"
        }
      }
    }
  }
}
