{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilxyr.dev/schemas/executor-conformance-suite.v1.json",
  "title": "ilxyr executor conformance suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "environment_id", "tests"],
  "properties": {
    "schema": { "const": "ilxyr.executor_conformance_suite.v1" },
    "id": { "type": "string", "pattern": "^conformance://\\S+$" },
    "environment_id": { "type": "string", "pattern": "^environment://\\S+$" },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "execution_class", "requirement"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "execution_class": { "enum": ["offline", "linux_microvm"] },
          "requirement": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
