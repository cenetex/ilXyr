{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilxyr.cenetex.net/schemas/weight-multiplicity-phase05-plan.schema.json",
  "title": "Weight-multiplicity Phase 0.5 dimension-indexed frontier plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope_revision",
    "parent_contract_revision",
    "parent_contract_received_sha256",
    "oracle",
    "generator",
    "coordinates",
    "frontier",
    "cross_check",
    "decision",
    "predecessor"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "scope_revision": { "const": "phase-0.5-client-approved-2026-08-30" },
    "parent_contract_revision": { "const": "3-final-execution-copy" },
    "parent_contract_received_sha256": {
      "const": "e77a6341155242a7e08e8a0675100fd347fbf1d637c58092561ea2c052dc6b3c"
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "algorithm", "interface_version", "cache_scope", "cache_eviction", "zero_revision"],
      "properties": {
        "implementation": { "const": "zero-freudenthal-exact-c11" },
        "algorithm": { "const": "freudenthal_recurrence" },
        "interface_version": { "const": 2 },
        "cache_scope": { "const": "one_type_and_highest_weight_per_worker" },
        "cache_eviction": { "const": "on_type_or_highest_weight_change" },
        "zero_revision": {
          "anyOf": [
            { "const": "to-be-frozen-before-binding-run" },
            { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
          ]
        }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version", "seed", "candidate_envelope", "representation_selection", "targets_per_representation", "target_depth_anchors_per_mille", "targets_per_depth_anchor", "non_dominant_target_index_per_anchor", "deduplication"],
      "properties": {
        "implementation": { "const": "ilxyr-weight-multiplicity-phase05-frontier" },
        "version": { "const": 1 },
        "seed": { "const": 230917 },
        "candidate_envelope": {
          "const": { "minimum_highest_weight_height": 1, "maximum_highest_weight_height": 8 }
        },
        "representation_selection": {
          "const": {
            "include_all_fundamental_representations": true,
            "include_phase0_v2_first_timeout_highest_weights": true,
            "selectors_per_populated_dimension_band": ["minimum_dimension", "nearest_geometric_midpoint", "maximum_dimension"],
            "tie_break": "lexicographic_highest_weight_dynkin_labels",
            "phase0_v2_first_timeout_cases": {
              "B7": { "highest_weight": [1, 0, 1, 0, 1, 2, 1], "target_weight": [0, 1, 0, 1, 1, 0, 1] },
              "B8": { "highest_weight": [0, 0, 0, 0, 1, 1, 2, 0], "target_weight": [0, 1, -1, 1, 0, 2, 0, 0] },
              "C7": { "highest_weight": [0, 2, 0, 1, 2, 1, 0], "target_weight": [0, 1, 0, 1, 1, 1, 0] },
              "C8": { "highest_weight": [0, 0, 0, 1, 0, 1, 1, 1], "target_weight": [0, 0, 0, 1, 1, 0, 0, 1] },
              "D7": { "highest_weight": [1, 1, 1, 1, 2, 1, 1], "target_weight": [0, 0, 1, 2, 0, 0, 2] },
              "D8": { "highest_weight": [0, 1, 0, 2, 0, 2, 0, 0], "target_weight": [0, 0, 0, 1, 0, 2, 0, 0] },
              "E7": { "highest_weight": [0, 0, 2, 1, 0, 0, 0], "target_weight": [1, 1, 0, 1, 0, 0, 0] },
              "E8": { "highest_weight": [0, 0, 1, 0, 0, 0, 0, 0], "target_weight": [0, 1, 0, 0, 0, 0, 0, 0] }
            }
          }
        },
        "targets_per_representation": { "const": 32 },
        "target_depth_anchors_per_mille": { "const": [125, 250, 375, 500, 625, 750, 875, 950] },
        "targets_per_depth_anchor": { "const": 4 },
        "non_dominant_target_index_per_anchor": { "const": 3 },
        "deduplication": { "const": "report_raw_and_unique_dominant_targets" }
      }
    },
    "coordinates": {
      "const": {
        "cartan": "A_ij=<alpha_i_coroot,alpha_j>",
        "weights": "integer_dynkin_labels",
        "roots": "integer_simple_root_coefficients",
        "representation_dimension": "exact_weyl_dimension_formula",
        "highest_weight_height": "sum_of_highest_weight_dynkin_labels_secondary_only",
        "target_depth": "signed_sum_of_integer_simple_root_coefficients_in_lambda_minus_mu",
        "dominance": "all_target_dynkin_labels_nonnegative",
        "weyl_action": "s_i(mu)=mu-mu_i*cartan_column_i"
      }
    },
    "frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["types", "dimension_bands", "binding_target_order", "sensitivity_target_orders", "cold_baseline", "query_timeout_ms", "p95_limit_ms", "peak_incremental_memory_limit_bytes", "replays", "parallelism_candidates", "parallelism_basis"],
      "properties": {
        "types": {
          "const": ["A1", "A2", "A3", "A4", "A5", "A6", "A7", "A8", "B2", "B3", "B4", "B5", "B6", "B7", "B8", "C3", "C4", "C5", "C6", "C7", "C8", "D4", "D5", "D6", "D7", "D8", "G2", "F4", "E6", "E7", "E8"]
        },
        "dimension_bands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "lower_inclusive", "upper_exclusive"],
            "properties": {
              "id": { "type": "string", "pattern": "^d[0-9]{2}-[0-9]{2}$" },
              "lower_inclusive": { "type": "string", "pattern": "^[1-9][0-9]*$" },
              "upper_exclusive": { "type": "string", "pattern": "^[1-9][0-9]*$" }
            }
          }
        },
        "binding_target_order": { "const": "ascending_depth_dominant_first_lexicographic" },
        "sensitivity_target_orders": { "const": ["descending_depth_dominant_first_lexicographic", "seeded_generation_order"] },
        "cold_baseline": { "const": "fresh_memo_every_query" },
        "query_timeout_ms": { "const": 1000 },
        "p95_limit_ms": { "const": 1000 },
        "peak_incremental_memory_limit_bytes": { "const": 2147483648 },
        "replays": { "const": 2 },
        "parallelism_candidates": { "const": [1, 2, 4, 8] },
        "parallelism_basis": { "const": "grouped_persistent_stress_representations" }
      }
    },
    "cross_check": {
      "const": {
        "implementation": "lie-2.2.2-separate-executable",
        "purpose": "independent_correctness_witness",
        "minimum_cases_per_type": 12,
        "include_all_e7_e8_fundamental_representations": true,
        "unresolved_disagreement_decision": "hold",
        "production_dependency": false
      }
    },
    "decision": {
      "const": {
        "time_limit_is_binding": true,
        "memory_limit_is_binding": true,
        "order_sensitivity_is_reportable_boundary": true,
        "outcomes": ["proceed", "rescope", "hold", "stop"],
        "corpus_requires_separate_client_approval": true
      }
    },
    "predecessor": {
      "const": {
        "phase0_v2_plan_sha256": "0801102bae37e746f688b1f6f9d2e2198f5e702a0e536d85d333fb80dff4d176",
        "phase0_v2_raw_result_sha256": "45e77630a9dd4005256627970c853573e71537f1076400b26391efb9450a5052",
        "phase0_v2_compressed_result_sha256": "170803ee08bb5fa26dea5c9a983511e2eb740d90387af3d887c379b8469a8aa8",
        "relationship": "new_client_approved_surface_old_evidence_remains_binding_for_revision_3"
      }
    }
  }
}
