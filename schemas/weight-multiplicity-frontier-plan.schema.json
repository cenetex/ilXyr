{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilxyr.cenetex.net/schemas/weight-multiplicity-frontier-plan.schema.json",
  "title": "Weight-multiplicity Phase 0 frontier plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_revision",
    "contract_received_sha256",
    "oracle",
    "generator",
    "coordinates",
    "frontier",
    "budget_rule"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "contract_revision": { "const": "3-final-execution-copy" },
    "contract_received_sha256": {
      "const": "e77a6341155242a7e08e8a0675100fd347fbf1d637c58092561ea2c052dc6b3c"
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "interface_version", "zero_revision"],
      "properties": {
        "implementation": { "const": "zero-freudenthal-exact-c11" },
        "interface_version": { "const": 1 },
        "zero_revision": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "version", "seed", "deduplication"],
      "properties": {
        "implementation": { "const": "ilxyr-weight-multiplicity-frontier" },
        "version": { "const": 1 },
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "deduplication": { "const": "report-unique-count-do-not-cache-labels" }
      }
    },
    "coordinates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cartan",
        "weights",
        "roots",
        "highest_weight_height",
        "target_depth",
        "target_magnitude",
        "dominance",
        "weyl_action"
      ],
      "properties": {
        "cartan": { "const": "A_ij=<alpha_i_coroot,alpha_j>" },
        "weights": { "const": "integer_dynkin_labels" },
        "roots": { "const": "integer_simple_root_coefficients" },
        "highest_weight_height": { "const": "sum_of_highest_weight_dynkin_labels" },
        "target_depth": {
          "const": "signed_sum_of_integer_simple_root_coefficients_in_lambda_minus_mu"
        },
        "target_magnitude": { "const": "l1_norm_of_target_dynkin_labels" },
        "dominance": { "const": "all_target_dynkin_labels_nonnegative" },
        "weyl_action": { "const": "s_i(mu)=mu-mu_i*cartan_column_i" }
      }
    },
    "frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "types",
        "heights",
        "cell_key",
        "accepted_queries_per_cell",
        "stratum_quota",
        "target_status_quota_by_stratum",
        "dominant_quota",
        "non_dominant_quota",
        "depth_bands",
        "minimum_per_depth_band",
        "attempt_cap_per_cell",
        "replays",
        "query_timeout_ms",
        "p95_limit_ms",
        "peak_incremental_memory_limit_bytes",
        "parallelism_candidates"
      ],
      "properties": {
        "types": {
          "const": [
            "A1", "A2", "A3", "A4", "A5", "A6", "A7", "A8",
            "B2", "B3", "B4", "B5", "B6", "B7", "B8",
            "C3", "C4", "C5", "C6", "C7", "C8",
            "D4", "D5", "D6", "D7", "D8",
            "G2", "F4", "E6", "E7", "E8"
          ]
        },
        "heights": { "const": [1, 2, 3, 4, 5, 6, 7, 8] },
        "cell_key": { "const": ["type", "highest_weight_height"] },
        "accepted_queries_per_cell": { "const": 100 },
        "stratum_quota": {
          "const": { "0": 25, "1": 25, "2-7": 25, "8-31": 25 }
        },
        "target_status_quota_by_stratum": {
          "const": {
            "0": { "dominant": 19, "non_dominant": 6 },
            "1": { "dominant": 19, "non_dominant": 6 },
            "2-7": { "dominant": 19, "non_dominant": 6 },
            "8-31": { "dominant": 18, "non_dominant": 7 }
          }
        },
        "dominant_quota": { "const": 75 },
        "non_dominant_quota": { "const": 25 },
        "depth_bands": {
          "const": [
            { "id": "q1", "lower_per_mille": 0, "upper_per_mille": 250 },
            { "id": "q2", "lower_per_mille": 251, "upper_per_mille": 500 },
            { "id": "q3", "lower_per_mille": 501, "upper_per_mille": 750 },
            { "id": "q4", "lower_per_mille": 751, "upper_per_mille": 1000 }
          ]
        },
        "minimum_per_depth_band": { "const": 0 },
        "attempt_cap_per_cell": { "type": "integer", "minimum": 100 },
        "replays": { "const": 2 },
        "query_timeout_ms": { "const": 1000 },
        "p95_limit_ms": { "const": 1000 },
        "peak_incremental_memory_limit_bytes": { "const": 2147483648 },
        "parallelism_candidates": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "budget_rule": {
      "const": "upper_95_percent_estimate_plus_15_percent_operational_margin"
    }
  }
}
