{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilxyr.dev/schemas/paper-contract.v1.json",
  "title": "ilxyr paper contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title"],
  "properties": {
    "schema": { "const": "ilxyr.paper_contract.v1" },
    "id": { "$ref": "#/$defs/identifier" },
    "title": { "type": "string", "minLength": 1 },
    "non_claims": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "required_claims": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/-]+$"
    }
  }
}
