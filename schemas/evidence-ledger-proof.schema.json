{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilxyr.dev/schemas/evidence-ledger-proof.v1.json",
  "title": "Detached evidence ledger proof v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "bundle_sha256", "bundle_json", "evidence_json", "run_json", "evidence_ref", "evidence_event_hash", "ledger_head", "events"],
  "properties": {
    "schema": { "const": "ilxyr.evidence_ledger_proof.v1" },
    "bundle_sha256": { "$ref": "#/$defs/digest" },
    "bundle_json": { "type": "string", "minLength": 2 },
    "evidence_json": { "type": "string", "minLength": 2 },
    "run_json": { "type": "string", "minLength": 2 },
    "evidence_ref": { "type": "string", "pattern": "^artifact://sha256/[a-f0-9]{64}$" },
    "evidence_event_hash": { "$ref": "#/$defs/digest" },
    "ledger_head": { "$ref": "#/$defs/digest" },
    "events": { "type": "array", "minItems": 1, "maxItems": 100000, "items": { "$ref": "#/$defs/event" } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "event_type", "aggregate_id", "actor", "occurred_at_ms", "event_hash"],
      "properties": {
        "schema": { "const": "ilxyr.event.v1" },
        "event_type": { "type": "string", "minLength": 1 },
        "aggregate_id": { "type": "string", "minLength": 1 },
        "actor": {
          "type": "object", "additionalProperties": false, "required": ["id", "kind"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "kind": { "enum": ["human", "model", "service"] },
            "model_ref": { "type": "string" }
          }
        },
        "artifact_ref": { "type": "string", "pattern": "^artifact://sha256/[a-f0-9]{64}$" },
        "occurred_at_ms": { "type": "integer", "minimum": 0 },
        "previous_event": { "$ref": "#/$defs/digest" },
        "event_hash": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
