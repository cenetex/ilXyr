{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilxyr.dev/schemas/huggingface-model.v1.json",
  "title": "ilxyr Hugging Face model v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "model_ref",
    "weight_ref",
    "repo_id",
    "repository",
    "revision",
    "pipeline_tag",
    "library_name",
    "license",
    "files"
  ],
  "properties": {
    "schema": { "const": "ilxyr.huggingface_model.v1" },
    "model_ref": {
      "type": "string",
      "pattern": "^model://huggingface/(?!\\.{1,2}/)[A-Za-z0-9._-]+/(?!\\.{1,2}@)[A-Za-z0-9._-]+@[0-9a-f]{40}$"
    },
    "weight_ref": {
      "type": "string",
      "pattern": "^weight://huggingface/(?!\\.{1,2}/)[A-Za-z0-9._-]+/(?!\\.{1,2}@)[A-Za-z0-9._-]+@[0-9a-f]{40}$"
    },
    "repo_id": {
      "type": "string",
      "pattern": "^(?!\\.{1,2}/)[A-Za-z0-9._-]+/(?!\\.{1,2}$)[A-Za-z0-9._-]+$"
    },
    "repository": {
      "type": "string",
      "pattern": "^https://huggingface\\.co/(?!\\.{1,2}/)[A-Za-z0-9._-]+/(?!\\.{1,2}$)[A-Za-z0-9._-]+$"
    },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "pipeline_tag": { "type": "string", "minLength": 1 },
    "library_name": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "base_model": { "type": "string", "minLength": 1 },
    "parameter_count": { "type": "integer", "minimum": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "blob_id"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\u0000]+$"
          },
          "size": { "type": "integer", "minimum": 0 },
          "blob_id": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
