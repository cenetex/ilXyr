{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilxyr.dev/schemas/experiment-proposal.v1.json",
  "title": "ilxyr experiment proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "revision",
    "experiment_id",
    "proposer",
    "title",
    "summary",
    "hypothesis",
    "novelty",
    "family",
    "baseline",
    "datasets",
    "primary_metric",
    "success_operator",
    "success_threshold",
    "seeds",
    "compute_credits",
    "evidence_level",
    "export_policy"
  ],
  "properties": {
    "schema": { "const": "ilxyr.experiment_proposal.v1" },
    "id": { "$ref": "https://ilxyr.dev/schemas/contribution.v1.json#/$defs/identifier" },
    "revision": { "type": "integer", "minimum": 1 },
    "predecessor_ref": { "$ref": "#/$defs/artifact_ref" },
    "experiment_id": { "$ref": "https://ilxyr.dev/schemas/contribution.v1.json#/$defs/identifier" },
    "proposer": { "$ref": "https://ilxyr.dev/schemas/contribution.v1.json#/$defs/actor" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "hypothesis": { "type": "string", "minLength": 1 },
    "novelty": { "type": "string", "minLength": 1 },
    "family": { "enum": ["zero", "solomon"] },
    "baseline": { "$ref": "#/$defs/opaque_uri" },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^dataset://\\S+$" }
    },
    "primary_metric": { "type": "string", "minLength": 1 },
    "success_operator": { "enum": ["gt", "gte", "lt", "lte"] },
    "success_threshold": { "type": "number" },
    "seeds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 0 }
    },
    "compute_credits": { "type": "integer", "minimum": 1 },
    "evidence_level": {
      "enum": ["exact_check", "deterministic_replay", "corpus_proxy", "review"]
    },
    "export_policy": { "enum": ["artifacts", "metrics_only", "none"] }
  },
  "allOf": [
    {
      "if": { "properties": { "revision": { "const": 1 } }, "required": ["revision"] },
      "then": { "properties": { "predecessor_ref": false } },
      "else": {
        "properties": { "predecessor_ref": { "$ref": "#/$defs/artifact_ref" } },
        "required": ["predecessor_ref"]
      }
    }
  ],
  "$defs": {
    "artifact_ref": {
      "type": "string",
      "pattern": "^artifact://sha256/[a-f0-9]{64}$"
    },
    "opaque_uri": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://\\S+$"
    }
  }
}
