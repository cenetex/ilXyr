{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilxyr.dev/schemas/weight-multiplicity-program.schema.json",
  "title": "ilXyr verified-oracle weight-multiplicity program",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "revision",
    "status",
    "source_document",
    "primary_question",
    "task",
    "roles",
    "oracle_frontier",
    "datasets",
    "models",
    "gates",
    "decision_policy",
    "schedule",
    "deliverables",
    "acceptance",
    "intellectual_property",
    "exclusions"
  ],
  "properties": {
    "schema": { "const": "ilxyr.weight_multiplicity_program.v1" },
    "id": { "const": "weight-multiplicity-transfer-r3" },
    "revision": { "const": 3 },
    "status": { "const": "signed_execution_contract" },
    "source_document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "received_sha256", "canonical_repository_path", "canonical_sha256"],
      "properties": {
        "title": { "const": "Statement of Work — Verified-Oracle Weight-Multiplicity Transfer" },
        "received_sha256": {
          "const": "e77a6341155242a7e08e8a0675100fd347fbf1d637c58092561ea2c052dc6b3c"
        },
        "canonical_repository_path": { "const": "docs/contracts/WEIGHT-MULTIPLICITY-TRANSFER-R3.md" },
        "canonical_sha256": { "const": "5cbd190d12cc3f40a3dcd62cd793f9da0b8252a6314e06128a1b80cb373222be" }
      }
    },
    "primary_question": {
      "const": "Can a small model trained on exact weight-multiplicity examples transfer to unseen ranks and to non-dominant weights at those ranks?"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "minimum_label", "maximum_exact_label", "strata", "tail_policy"],
      "properties": {
        "target": { "const": "exact_integer_weight_multiplicity" },
        "minimum_label": { "const": 0 },
        "maximum_exact_label": { "const": 31 },
        "strata": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            { "$ref": "#/$defs/stratum_zero" },
            { "$ref": "#/$defs/stratum_one" },
            { "$ref": "#/$defs/stratum_two_to_seven" },
            { "$ref": "#/$defs/stratum_eight_to_thirty_one" }
          ],
          "items": false
        },
        "tail_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision_gate", "natural_distribution"],
          "properties": {
            "decision_gate": { "const": "exclude_above_31" },
            "natural_distribution": { "const": "report_and_count_as_incorrect_end_to_end" }
          }
        }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["control_plane", "oracle", "research_models", "integer_feasibility"],
      "properties": {
        "control_plane": { "const": "ilxyr" },
        "oracle": { "const": "zero_symbolic" },
        "research_models": { "const": "three_full_input_seeds_plus_one_shortcut_null" },
        "integer_feasibility": { "const": "nsrl_note_only" }
      }
    },
    "oracle_frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_rank",
        "maximum_height",
        "uncached_queries_per_cell",
        "cell_dimensions",
        "maximum_p95_latency_ms",
        "maximum_incremental_memory_mib_per_worker",
        "cell_pass_conditions",
        "deterministic_replay_required",
        "budget_method",
        "budget_margin_per_mille",
        "overrun_policy",
        "out_of_frontier_policy",
        "required_report_fields"
      ],
      "properties": {
        "maximum_rank": { "const": 8 },
        "maximum_height": { "const": 8 },
        "uncached_queries_per_cell": { "const": 100 },
        "cell_dimensions": {
          "const": [
            "lie_family",
            "rank",
            "highest_weight_height",
            "target_weight_depth",
            "multiplicity_stratum",
            "dominance_status",
            "oracle_implementation",
            "reference_hardware",
            "safe_parallel_worker_count"
          ]
        },
        "maximum_p95_latency_ms": { "const": 1000 },
        "maximum_incremental_memory_mib_per_worker": { "const": 2048 },
        "cell_pass_conditions": {
          "const": [
            "all_queries_return_exact_integers",
            "repeated_results_are_byte_identical",
            "no_crash",
            "no_timeout",
            "latency_and_memory_within_limits"
          ]
        },
        "deterministic_replay_required": { "const": true },
        "budget_method": { "const": "upper_95_percent_estimate_from_mean_latency_and_observed_yield" },
        "budget_margin_per_mille": { "const": 150 },
        "overrun_policy": { "const": "stop_generation_and_report" },
        "out_of_frontier_policy": { "const": "phase_1_does_not_begin_without_signed_scope_revision" },
        "required_report_fields": {
          "const": [
            "maximum_height_by_family_and_rank",
            "conservative_common_rank_height_boundary",
            "mean_p50_p95_latency",
            "safe_parallelism",
            "stratum_acceptance_rates",
            "projected_oracle_calls",
            "projected_cpu_core_hours",
            "projected_wall_clock_time",
            "per_query_budget_boundary"
          ]
        }
      }
    },
    "datasets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "training_families",
        "held_out_classical_families",
        "held_out_exceptional_types",
        "training_target_mix_per_mille",
        "non_dominant_sampling_dimensions",
        "one_target_per_orbit",
        "acr2_coordinate_envelope",
        "accepted_records"
      ],
      "properties": {
        "training_families": {
          "const": ["A1-A5", "B2-B5", "C3-C5", "D4-D5"]
        },
        "held_out_classical_families": {
          "const": ["A6-A8", "B6-B8", "C6-C8", "D6-D8"]
        },
        "held_out_exceptional_types": {
          "const": ["G2", "F4", "E6", "E7", "E8"]
        },
        "training_target_mix_per_mille": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dominant", "non_dominant"],
          "properties": {
            "dominant": { "const": 750 },
            "non_dominant": { "const": 250 }
          }
        },
        "non_dominant_sampling_dimensions": {
          "const": ["negative_coordinate_count", "coordinate_magnitude_band", "classical_family", "training_rank"]
        },
        "one_target_per_orbit": { "const": true },
        "acr2_coordinate_envelope": { "const": "within_frozen_training_non_dominant_scalar_range" },
        "accepted_records": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "training",
            "development",
            "blind_in_range_stratified",
            "blind_in_range_unstratified",
            "cross_rank_stratified",
            "cross_rank_unstratified",
            "exceptional_stratified",
            "exceptional_unstratified",
            "acr1",
            "acr2_transformed",
            "total"
          ],
          "properties": {
            "training": { "const": 300000 },
            "development": { "const": 30000 },
            "blind_in_range_stratified": { "const": 30000 },
            "blind_in_range_unstratified": { "const": 30000 },
            "cross_rank_stratified": { "const": 24000 },
            "cross_rank_unstratified": { "const": 24000 },
            "exceptional_stratified": { "const": 2500 },
            "exceptional_unstratified": { "const": 2500 },
            "acr1": { "const": 3750 },
            "acr2_transformed": { "const": 12000 },
            "total": { "const": 458750 }
          }
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full", "shortcut"],
      "properties": {
        "full": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seeds",
            "maximum_parameters",
            "maximum_cpu_core_hours_per_seed",
            "maximum_memory_mib",
            "maximum_median_inference_ms",
            "output_labels",
            "normalized_distribution",
            "shared_architecture_corpus_optimizer",
            "seed_specific_tuning",
            "blind_results_available_during_training",
            "gpu_allowed",
            "gpu_specific_operations_allowed"
          ],
          "properties": {
            "seeds": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 0 }
            },
            "maximum_parameters": { "const": 5000000 },
            "maximum_cpu_core_hours_per_seed": { "const": 500 },
            "maximum_memory_mib": { "const": 16384 },
            "maximum_median_inference_ms": { "const": 40 },
            "output_labels": { "const": 32 },
            "normalized_distribution": { "const": true },
            "shared_architecture_corpus_optimizer": { "const": true },
            "seed_specific_tuning": { "const": false },
            "blind_results_available_during_training": { "const": false },
            "gpu_allowed": { "const": false },
            "gpu_specific_operations_allowed": { "const": false }
          }
        },
        "shortcut": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seeds",
            "maximum_parameters",
            "maximum_cpu_core_hours",
            "same_training_labels",
            "output_labels",
            "normalized_distribution",
            "target_magnitude_definition_frozen_in_week_1",
            "allowed_inputs",
            "forbidden_inputs"
          ],
          "properties": {
            "seeds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": { "type": "integer", "minimum": 0 }
            },
            "maximum_parameters": { "const": 1000000 },
            "maximum_cpu_core_hours": { "const": 100 },
            "same_training_labels": { "const": true },
            "output_labels": { "const": 32 },
            "normalized_distribution": { "const": true },
            "target_magnitude_definition_frozen_in_week_1": { "const": true },
            "allowed_inputs": {
              "const": ["family", "rank", "highest_weight_height", "target_depth", "target_magnitude"]
            },
            "forbidden_inputs": {
              "const": [
                "cartan_matrix",
                "root_set",
                "positive_roots",
                "root_coordinates",
                "highest_weight_coordinates",
                "target_weight_coordinates",
                "weyl_data",
                "orbit_annotation"
              ]
            }
          }
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acr1", "acr2", "classical_cross_rank", "shortcut_clearance", "exceptional", "disagreement"],
      "properties": {
        "acr1": {
          "type": "object",
          "additionalProperties": false,
          "required": ["root_queries", "doubled_root_queries", "zero_weight_queries", "total", "expected_correct", "fixable_failure_policy", "clean_model_failure_policy"],
          "properties": {
            "root_queries": { "const": 1860 },
            "doubled_root_queries": { "const": 1860 },
            "zero_weight_queries": { "const": 30 },
            "total": { "const": 3750 },
            "expected_correct": { "const": 3750 },
            "fixable_failure_policy": { "const": "pause_diagnose_version_repair_and_rerun" },
            "clean_model_failure_policy": { "const": "stop" }
          }
        },
        "acr2": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pairs",
            "pairs_per_stratum",
            "coxeter_length_bands",
            "construction",
            "rejection_rules",
            "hidden_at_inference",
            "pass_per_mille",
            "rescope_per_mille"
          ],
          "properties": {
            "pairs": { "const": 12000 },
            "pairs_per_stratum": { "const": 3000 },
            "coxeter_length_bands": { "const": 4 },
            "construction": {
              "const": [
                "dominant_base_weight",
                "non_dominant_weyl_orbit_partner",
                "unseen_highest_weights",
                "unseen_classical_ranks",
                "nontrivial_weyl_elements"
              ]
            },
            "rejection_rules": {
              "const": [
                "transformed_weight_equals_base",
                "transformed_weight_remains_dominant",
                "multiplicity_above_31",
                "coordinate_outside_frozen_training_envelope",
                "duplicate_evaluation_query",
                "orbit_information_exposed_by_annotation"
              ]
            },
            "hidden_at_inference": {
              "const": [
                "dominant_representative",
                "weyl_word_or_action_matrix",
                "orbit_identifier",
                "paired_input",
                "multiplicity",
                "oracle_access"
              ]
            },
            "pass_per_mille": { "$ref": "#/$defs/acr2_pass" },
            "rescope_per_mille": { "$ref": "#/$defs/acr2_rescope" }
          }
        },
        "classical_cross_rank": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pass_median_per_mille", "pass_every_seed_per_mille", "stop_median_below_per_mille", "stop_any_seed_below_per_mille"],
          "properties": {
            "pass_median_per_mille": { "const": 900 },
            "pass_every_seed_per_mille": { "const": 850 },
            "stop_median_below_per_mille": { "const": 750 },
            "stop_any_seed_below_per_mille": { "const": 650 }
          }
        },
        "shortcut_clearance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["median_advantage_per_mille", "every_seed_advantage_per_mille", "bootstrap_lower_bound_per_mille", "bootstrap_resamples", "cluster_unit", "point_failure", "confidence_failure"],
          "properties": {
            "median_advantage_per_mille": { "const": 100 },
            "every_seed_advantage_per_mille": { "const": 50 },
            "bootstrap_lower_bound_per_mille": { "const": 75 },
            "bootstrap_resamples": { "const": 10000 },
            "cluster_unit": { "const": "highest_weight_representation" },
            "point_failure": { "const": "stop_shortcut_indistinguishable" },
            "confidence_failure": { "const": "rescope" }
          }
        },
        "exceptional": {
          "type": "object",
          "additionalProperties": false,
          "required": ["samples_per_type", "median_threshold_per_mille", "every_seed_threshold_per_mille", "confidence_interval", "straddling_policy"],
          "properties": {
            "samples_per_type": { "const": 500 },
            "median_threshold_per_mille": { "const": 700 },
            "every_seed_threshold_per_mille": { "const": 600 },
            "confidence_interval": { "const": "representation_clustered_bootstrap_95_percent_10000_resamples" },
            "straddling_policy": { "const": "hold" }
          }
        },
        "disagreement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["score", "minimum_auroc_per_mille", "minimum_auroc_lower_bound_per_mille", "top_to_bottom_error_ratio_per_mille", "minimum_absolute_error_increase_per_mille"],
          "properties": {
            "score": { "const": "jensen_shannon_divergence" },
            "minimum_auroc_per_mille": { "const": 650 },
            "minimum_auroc_lower_bound_per_mille": { "const": 600 },
            "top_to_bottom_error_ratio_per_mille": { "const": 1500 },
            "minimum_absolute_error_increase_per_mille": { "const": 50 }
          }
        }
      }
    },
    "decision_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid_outcomes", "pass", "classical_pass_exceptional_hold", "rescope", "stop"],
      "properties": {
        "valid_outcomes": { "const": ["pass", "classical_pass_exceptional_hold", "rescope", "stop"] },
        "pass": {
          "const": [
            "acr1_clean_or_repaired_integrity",
            "acr2_pass",
            "classical_cross_rank_pass",
            "shortcut_clearance_pass",
            "all_exceptional_types_pass"
          ]
        },
        "classical_pass_exceptional_hold": {
          "const": [
            "acr1_clean_or_repaired_integrity",
            "acr2_pass",
            "classical_cross_rank_pass",
            "shortcut_clearance_pass",
            "one_or_more_exceptional_types_hold_or_fail"
          ]
        },
        "rescope": {
          "const": [
            "metric_in_rescope_range",
            "integrity_repair_exceeds_current_envelope",
            "shortcut_point_margin_passes_but_confidence_fails"
          ]
        },
        "stop": {
          "const": [
            "clean_model_acr1_failure",
            "acr2_below_rescope",
            "classical_median_below_750_per_mille",
            "any_classical_seed_below_650_per_mille",
            "shortcut_point_margin_failure",
            "leakage",
            "oracle_or_resource_frontier_failure"
          ]
        }
      }
    },
    "schedule": {
      "const": [
        "week_1_specification",
        "week_2_oracle_frontier",
        "week_3_corpus",
        "weeks_4_5_training",
        "week_6_blind_evaluation",
        "week_7_decision_and_handoff"
      ]
    },
    "deliverables": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "enum": [
          "project_source",
          "oracle_adapters_and_validation_tests",
          "frozen_schemas_and_configurations",
          "oracle_frontier_yield_and_cost_report",
          "generated_corpora_and_manifests",
          "three_full_model_checkpoints",
          "shortcut_baseline_checkpoint",
          "shortcut_cross_rank_and_unstratified_results",
          "paired_shortcut_clearance_analysis",
          "training_and_evaluation_traces",
          "stratified_and_unstratified_results",
          "out_of_range_coverage",
          "per_type_exceptional_results_and_intervals",
          "acr1_integrity_versions_and_repairs",
          "acr2_manifest_and_results",
          "uncertainty_analysis",
          "ilxyr_evidence_records",
          "final_decision_report",
          "negative_result_analysis_if_applicable",
          "integer_model_feasibility_note"
        ]
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["negative_result_accepted", "scientific_pass_required", "valid_outcomes"],
      "properties": {
        "negative_result_accepted": { "const": true },
        "scientific_pass_required": { "const": false },
        "valid_outcomes": { "const": ["pass", "classical_pass_exceptional_hold", "rescope", "stop"] }
      }
    },
    "intellectual_property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client_owns", "supplier_retains", "corpora", "client_license", "publication"],
      "properties": {
        "client_owns": { "const": ["project_specific_application_code", "trained_model_weights"] },
        "supplier_retains": { "const": ["pre_existing_ilxyr_zero_nsrl", "general_methodology", "schemas", "evaluation_patterns", "reusable_harness_designs"] },
        "corpora": { "const": "delivered_non_exclusively_subject_to_upstream_licenses" },
        "client_license": { "const": "perpetual_for_retained_components_required_to_use_deliverables" },
        "publication": { "const": "separate_written_agreement_required" }
      }
    },
    "exclusions": {
      "const": [
        "exact_prediction_above_31",
        "tensor_product_decomposition",
        "branching_rules",
        "multi_agent_curiosity_swarm",
        "gpu_training",
        "integer_model_port",
        "production_deployment",
        "theorem_or_conjecture_guarantees",
        "natural_language_capability",
        "work_beyond_seven_weeks"
      ]
    }
  },
  "$defs": {
    "stratum_zero": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "minimum", "maximum", "share_per_mille"],
      "properties": {
        "id": { "const": "zero" },
        "minimum": { "const": 0 },
        "maximum": { "const": 0 },
        "share_per_mille": { "const": 250 }
      }
    },
    "stratum_one": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "minimum", "maximum", "share_per_mille"],
      "properties": {
        "id": { "const": "one" },
        "minimum": { "const": 1 },
        "maximum": { "const": 1 },
        "share_per_mille": { "const": 250 }
      }
    },
    "stratum_two_to_seven": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "minimum", "maximum", "share_per_mille"],
      "properties": {
        "id": { "const": "two_to_seven" },
        "minimum": { "const": 2 },
        "maximum": { "const": 7 },
        "share_per_mille": { "const": 250 }
      }
    },
    "stratum_eight_to_thirty_one": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "minimum", "maximum", "share_per_mille"],
      "properties": {
        "id": { "const": "eight_to_thirty_one" },
        "minimum": { "const": 8 },
        "maximum": { "const": 31 },
        "share_per_mille": { "const": 250 }
      }
    },
    "acr2_pass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["median_non_dominant", "every_seed_non_dominant", "maximum_dominant_drop", "maximum_consistency_deficit"],
      "properties": {
        "median_non_dominant": { "const": 850 },
        "every_seed_non_dominant": { "const": 800 },
        "maximum_dominant_drop": { "const": 30 },
        "maximum_consistency_deficit": { "const": 30 }
      }
    },
    "acr2_rescope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["median_non_dominant", "every_seed_non_dominant", "maximum_dominant_drop", "maximum_consistency_deficit"],
      "properties": {
        "median_non_dominant": { "const": 750 },
        "every_seed_non_dominant": { "const": 650 },
        "maximum_dominant_drop": { "const": 100 },
        "maximum_consistency_deficit": { "const": 100 }
      }
    }
  }
}
