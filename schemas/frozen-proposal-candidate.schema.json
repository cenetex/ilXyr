{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilxyr.dev/schemas/frozen-proposal-candidate.v1.json",
  "title": "ilxyr frozen proposal candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "proposal_id",
    "proposal_ref",
    "revision",
    "proposer",
    "review_refs",
    "frozen_at_ms"
  ],
  "properties": {
    "schema": { "const": "ilxyr.frozen_proposal_candidate.v1" },
    "id": { "$ref": "https://ilxyr.dev/schemas/contribution.v1.json#/$defs/identifier" },
    "proposal_id": { "$ref": "https://ilxyr.dev/schemas/contribution.v1.json#/$defs/identifier" },
    "proposal_ref": { "$ref": "#/$defs/artifact_ref" },
    "revision": { "type": "integer", "minimum": 1 },
    "proposer": { "$ref": "https://ilxyr.dev/schemas/contribution.v1.json#/$defs/actor" },
    "review_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact_ref" }
    },
    "frozen_at_ms": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "artifact_ref": {
      "type": "string",
      "pattern": "^artifact://sha256/[a-f0-9]{64}$"
    }
  }
}
