{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilxyr.dev/schemas/azure-ml-corpus-handoff.v1.json",
  "title": "ilxyr Azure ML corpus handoff v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "corpus_ref",
    "materialization_ref",
    "expected_files",
    "materialized_objects",
    "data_asset",
    "job_input"
  ],
  "properties": {
    "schema": { "const": "ilxyr.azure_ml_corpus_handoff.v1" },
    "corpus_ref": { "$ref": "#/$defs/artifactRef" },
    "materialization_ref": { "$ref": "#/$defs/artifactRef" },
    "expected_files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/corpusFile" }
    },
    "materialized_objects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/materializedObject" }
    },
    "data_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "type", "path", "properties"],
      "properties": {
        "name": { "$ref": "#/$defs/cloudName" },
        "version": { "$ref": "#/$defs/sha256" },
        "type": { "const": "uri_folder" },
        "path": {
          "type": "string",
          "pattern": "^(?:https://[^/\\s]+\\.blob\\.core\\.windows\\.net/|azureml://datastores/)"
        },
        "properties": {
          "type": "object",
          "required": ["ilxyr_corpus_ref", "ilxyr_materialization_ref"],
          "additionalProperties": false,
          "properties": {
            "ilxyr_corpus_ref": { "$ref": "#/$defs/artifactRef" },
            "ilxyr_materialization_ref": { "$ref": "#/$defs/artifactRef" }
          }
        }
      }
    },
    "job_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "path", "mode"],
      "properties": {
        "name": { "$ref": "#/$defs/cloudName" },
        "type": { "const": "uri_folder" },
        "path": { "type": "string", "pattern": "^azureml:[A-Za-z0-9._-]+:[0-9a-f]{64}$" },
        "mode": { "enum": ["download", "ro_mount"] }
      }
    }
  },
  "$defs": {
    "artifactRef": { "type": "string", "pattern": "^artifact://sha256/[0-9a-f]{64}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "cloudName": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "maxLength": 128 },
    "corpusFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "media_type"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "media_type": { "type": "string", "minLength": 1 }
      }
    },
    "materializedObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "uri", "sha256", "size_bytes", "provider_version"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "uri": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 0 },
        "provider_version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
