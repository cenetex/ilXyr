{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilxyr.dev/schemas/corpus-rights-review.v1.json",
  "title": "ilXyr corpus rights review v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "reviewed_at",
    "jurisdiction",
    "status",
    "summary",
    "scope",
    "basis",
    "corpus_scan",
    "allowed_uses",
    "prohibited_uses",
    "conditions",
    "authorization"
  ],
  "properties": {
    "schema": { "const": "ilxyr.corpus_rights_review.v1" },
    "id": { "type": "string", "pattern": "^rights-review://\\S+$" },
    "title": { "type": "string", "minLength": 1 },
    "reviewed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "jurisdiction": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["approved", "approved_with_conditions", "blocked"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "corpus_id",
          "release_id",
          "release_manifest_sha256",
          "examples",
          "source_rights_assertion"
        ],
        "properties": {
          "corpus_id": { "type": "string", "pattern": "^dataset://\\S+$" },
          "release_id": { "type": "string", "minLength": 1 },
          "release_manifest_sha256": { "$ref": "#/$defs/sha256" },
          "examples": { "type": "integer", "minimum": 1 },
          "source_rights_assertion": { "type": "string", "minLength": 1 }
        }
      }
    },
    "basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["authority", "title", "url", "weight", "finding"],
        "properties": {
          "authority": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://\\S+$" },
          "weight": { "enum": ["primary", "supplemental", "advisory"] },
          "finding": { "type": "string", "minLength": 1 }
        }
      }
    },
    "corpus_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "total_examples", "pattern_counts", "interpretation"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "total_examples": { "type": "integer", "minimum": 1 },
        "pattern_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "combined_restrictive_language",
            "confidential",
            "reproduction_or_distribution",
            "copyright_or_third_party"
          ],
          "properties": {
            "combined_restrictive_language": { "type": "integer", "minimum": 0 },
            "confidential": { "type": "integer", "minimum": 0 },
            "reproduction_or_distribution": { "type": "integer", "minimum": 0 },
            "copyright_or_third_party": { "type": "integer", "minimum": 0 }
          }
        },
        "interpretation": { "type": "string", "minLength": 1 }
      }
    },
    "allowed_uses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "prohibited_uses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rights_clearance",
        "training_dispatch",
        "paid_compute",
        "public_corpus_distribution",
        "public_model_release"
      ],
      "properties": {
        "rights_clearance": {
          "enum": ["approved", "approved_with_conditions", "blocked"]
        },
        "training_dispatch": { "const": "not_authorized_by_this_review" },
        "paid_compute": { "const": "not_authorized_by_this_review" },
        "public_corpus_distribution": { "const": "prohibited" },
        "public_model_release": { "const": "requires_separate_review" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
