{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilxyr.dev/schemas/verified-executor-conformance.v1.json",
  "title": "ilxyr verified executor conformance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "report_ref",
    "report_body_ref",
    "environment_ref",
    "suite_ref",
    "runner",
    "passed",
    "verified_key_ids"
  ],
  "properties": {
    "schema": { "const": "ilxyr.verified_executor_conformance.v1" },
    "report_ref": { "$ref": "#/$defs/artifactRef" },
    "report_body_ref": { "$ref": "#/$defs/artifactRef" },
    "environment_ref": { "$ref": "#/$defs/artifactRef" },
    "suite_ref": { "$ref": "#/$defs/artifactRef" },
    "runner": { "$ref": "#/$defs/serviceActor" },
    "passed": { "type": "boolean" },
    "verified_key_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^key://\\S+$" }
    }
  },
  "$defs": {
    "artifactRef": { "type": "string", "pattern": "^artifact://sha256/[a-f0-9]{64}$" },
    "serviceActor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^service://\\S+$" },
        "kind": { "const": "service" }
      }
    }
  }
}
