{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilxyr.dev/schemas/executor-preflight-receipt.v1.json",
  "title": "ilxyr executor preflight receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "environment_ref",
    "job_package_ref",
    "verified_resources",
    "weight_class",
    "network",
    "export_policy",
    "guest_credentials_included",
    "launch_authorized"
  ],
  "properties": {
    "schema": { "const": "ilxyr.executor_preflight_receipt.v1" },
    "environment_ref": { "$ref": "#/$defs/artifactRef" },
    "job_package_ref": { "$ref": "#/$defs/artifactRef" },
    "verified_resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scope",
          "name",
          "uri",
          "sha256",
          "size_bytes",
          "relative_path"
        ],
        "properties": {
          "scope": { "enum": ["environment", "job"] },
          "name": { "type": "string", "minLength": 1 },
          "uri": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "relative_path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "weight_class": { "const": "public" },
    "network": { "const": "denied" },
    "export_policy": { "const": "metrics_only" },
    "guest_credentials_included": { "const": false },
    "launch_authorized": { "const": false }
  },
  "$defs": {
    "artifactRef": { "type": "string", "pattern": "^artifact://sha256/[a-f0-9]{64}$" }
  }
}
