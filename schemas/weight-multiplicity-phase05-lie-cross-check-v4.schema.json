{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilxyr.dev/schemas/weight-multiplicity-phase05-lie-cross-check-v4.schema.json",
  "title": "Phase 0.5 LiE cross-check manifest Version 4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "witness_version",
    "scope_revision",
    "purpose",
    "plan_sha256",
    "representation_manifest_sha256",
    "zero_executable_sha256",
    "lie",
    "coordinate_mapping",
    "lie_type_mapping",
    "selection",
    "cases",
    "summary"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "witness_version": { "const": 4 },
    "scope_revision": { "const": "phase-0.5-client-approved-2026-08-30" },
    "purpose": { "const": "independent_correctness_witness" },
    "plan_sha256": { "$ref": "#/$defs/sha256" },
    "representation_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "zero_executable_sha256": { "$ref": "#/$defs/sha256" },
    "lie": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source_url", "source_sha256", "production_dependency"],
      "properties": {
        "version": { "const": "2.2.2" },
        "source_url": { "type": "string", "pattern": "^https://" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "production_dependency": { "const": false }
      }
    },
    "coordinate_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "F4", "E6", "E7", "E8", "meaning"],
      "properties": {
        "default": { "const": "identity" },
        "F4": { "const": [3, 2, 1, 0] },
        "E6": { "const": [0, 5, 1, 2, 3, 4] },
        "E7": { "const": [0, 6, 1, 2, 3, 4, 5] },
        "E8": { "const": [0, 7, 1, 2, 3, 4, 5, 6] },
        "meaning": { "const": "LiE_coordinate_i_equals_Zero_coordinate_at_list_i" }
      }
    },
    "lie_type_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "B2", "B3", "B4", "B5", "B6", "B7", "B8", "C3", "C4", "C5", "C6", "C7", "C8", "meaning"],
      "properties": {
        "default": { "const": "same_type" },
        "B2": { "const": "C2" },
        "B3": { "const": "C3" },
        "B4": { "const": "C4" },
        "B5": { "const": "C5" },
        "B6": { "const": "C6" },
        "B7": { "const": "C7" },
        "B8": { "const": "C8" },
        "C3": { "const": "B3" },
        "C4": { "const": "B4" },
        "C5": { "const": "B5" },
        "C6": { "const": "B6" },
        "C7": { "const": "B7" },
        "C8": { "const": "B8" },
        "meaning": { "const": "Zero_Reasoner0_and_LiE_use_dual_Cartan_orientation_conventions" }
      }
    },
    "selection": { "type": "object" },
    "cases": {
      "type": "array",
      "minItems": 372,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "rank", "representation_id", "representation_source", "highest_weight", "representation_dimension", "target_weight", "target_depth", "target_status", "source_anchor_per_mille", "source_trajectory", "selection_reason"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string", "pattern": "^[A-G][1-8]$" },
          "rank": { "type": "integer", "minimum": 1, "maximum": 8 },
          "representation_id": { "type": "string" },
          "representation_source": { "enum": ["frontier_manifest", "candidate_envelope_fill"] },
          "highest_weight": { "$ref": "#/$defs/weight" },
          "representation_dimension": { "type": "string", "pattern": "^[1-9][0-9]*$" },
          "target_weight": { "$ref": "#/$defs/weight" },
          "target_depth": { "type": "integer", "minimum": 1 },
          "target_status": { "enum": ["dominant", "non_dominant"] },
          "source_anchor_per_mille": { "type": ["integer", "null"] },
          "source_trajectory": { "type": ["integer", "null"] },
          "selection_reason": { "enum": ["all_e7_e8_fundamentals_shallow_nontrivial", "height_and_depth_stratified"] }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases", "per_type"],
      "properties": {
        "cases": { "type": "integer", "minimum": 372 },
        "per_type": {
          "type": "object",
          "minProperties": 31,
          "additionalProperties": { "type": "integer", "minimum": 12 }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "weight": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "integer" }
    }
  }
}
