{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilxyr.dev/schemas/upstream-benchmark.v1.json",
  "title": "ilxyr upstream benchmark record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "benchmark_id", "outcome", "provenance", "raw"],
  "properties": {
    "schema": { "const": "ilxyr.upstream_benchmark.v1" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9._:/-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "benchmark_id": { "type": "string", "minLength": 1 },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolved_outcome", "metrics"],
      "properties": {
        "resolved_outcome": { "type": "string", "minLength": 1 },
        "metrics": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_files", "pinned_digests", "imported_with", "imported_at_ms"],
      "properties": {
        "source_files": {
          "type": "object",
          "required": ["contract.json", "result.json"],
          "additionalProperties": false,
          "properties": {
            "contract.json": { "$ref": "#/$defs/digest" },
            "result.json": { "$ref": "#/$defs/digest" }
          }
        },
        "pinned_digests": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/digest" }
        },
        "imported_with": { "const": "scripts/import-benchmark.mjs" },
        "imported_at_ms": { "type": "integer", "minimum": 1 }
      }
    },
    "raw": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "result"],
      "properties": {
        "contract": { "type": "object" },
        "result": { "type": "object" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
