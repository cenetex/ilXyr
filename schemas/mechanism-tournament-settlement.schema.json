{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ilxyr.mechanism_tournament_settlement.v1",
  "title": "Settled rival-mechanism tournament",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tournament_id",
    "experiment_id",
    "decision_row_id",
    "observations",
    "rival_scores",
    "lowest_scoring_rival_ids",
    "supported_rival_ids",
    "next_action",
    "settled_at_ms"
  ],
  "properties": {
    "schema": { "const": "ilxyr.mechanism_tournament_settlement.v1" },
    "tournament_id": { "$ref": "#/$defs/id" },
    "experiment_id": { "$ref": "#/$defs/id" },
    "decision_row_id": { "$ref": "#/$defs/id" },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/observation" }
    },
    "rival_scores": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/rivalScore" }
    },
    "lowest_scoring_rival_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "supported_rival_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "next_action": { "type": "string", "minLength": 1 },
    "settled_at_ms": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "outcome", "detail"],
      "properties": {
        "observation_id": { "$ref": "#/$defs/id" },
        "outcome": { "enum": ["satisfied", "unsatisfied"] },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "rivalScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rival_id", "brier_score"],
      "properties": {
        "rival_id": { "$ref": "#/$defs/id" },
        "brier_score": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
