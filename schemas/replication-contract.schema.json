{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilxyr.dev/schemas/replication-contract.v1.json",
  "title": "ilxyr replication contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "target_claim", "reference_evidence_ref",
    "replication_experiment_id", "kind", "eval_set", "declared_by", "declared_at_ms"
  ],
  "properties": {
    "schema": { "const": "ilxyr.replication_contract.v1" },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "target_claim": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/-]+$",
      "description": "ID of the immutable claim node being replicated."
    },
    "reference_evidence_ref": {
      "type": "string",
      "pattern": "^artifact://sha256/[a-f0-9]{64}$"
    },
    "replication_experiment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "kind": {
      "enum": ["capability", "computational_equivalence", "both"],
      "description": "Capability: metric within tolerance. Computational equivalence: per-input agreement over eval set."
    },
    "tolerances": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      },
      "description": "Map of metric name to maximum absolute deviation for capability replication.",
      "minProperties": 1
    },
    "eval_set": {
      "type": "string",
      "pattern": "^(dataset|artifact)://\\S+$",
      "description": "Handle for the evaluation set used for computational equivalence."
    },
    "agreement_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Minimum per-input agreement rate for computational equivalence. Default 1.0 for exact."
    },
    "agreement_metric": {
      "type": "string",
      "minLength": 1,
      "description": "Replication evidence metric containing the observed per-input agreement rate."
    },
    "declared_by": {
      "$ref": "https://ilxyr.dev/schemas/claim.v1.json#/$defs/actor"
    },
    "declared_at_ms": { "type": "integer", "minimum": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "enum": ["capability", "both"] } },
        "required": ["kind"]
      },
      "then": { "properties": { "tolerances": true }, "required": ["tolerances"] },
      "else": { "properties": { "tolerances": false } }
    },
    {
      "if": {
        "properties": { "kind": { "enum": ["computational_equivalence", "both"] } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "agreement_metric": true,
          "agreement_threshold": true
        },
        "required": ["agreement_metric", "agreement_threshold"]
      },
      "else": {
        "properties": {
          "agreement_metric": false,
          "agreement_threshold": false
        }
      }
    }
  ]
}
