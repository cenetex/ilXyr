{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilxyr.dev/schemas/corpus-release.v1.json",
  "title": "ilxyr corpus release v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "title", "version", "source", "rights", "files"],
  "properties": {
    "schema": { "const": "ilxyr.corpus_release.v1" },
    "id": {
      "type": "string",
      "pattern": "^(?:dataset|representation)://[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)+$"
    },
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "maxLength": 128 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision", "path"],
      "properties": {
        "repository": { "type": "string", "pattern": "^https://\\S+$" },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": { "$ref": "#/$defs/portablePath" }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license"],
      "properties": {
        "license": { "type": "string", "minLength": 1 },
        "use_constraints": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size_bytes", "media_type"],
        "properties": {
          "path": { "$ref": "#/$defs/portablePath" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "size_bytes": { "type": "integer", "minimum": 0 },
          "media_type": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 },
      "propertyNames": { "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "portablePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    }
  }
}
