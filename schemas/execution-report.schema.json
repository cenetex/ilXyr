{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilxyr.dev/schemas/execution-report.v1.json",
  "title": "ilxyr signed execution report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "job_package_ref",
    "authorization_ref",
    "launch_ref",
    "environment_ref",
    "executor",
    "provider_instance_id",
    "machine_image_id",
    "machine_image_sha256",
    "run",
    "run_ref",
    "outputs",
    "attestation",
    "reported_at_ms"
  ],
  "properties": {
    "schema": { "const": "ilxyr.execution_report.v1" },
    "job_package_ref": { "$ref": "#/$defs/artifactRef" },
    "authorization_ref": { "$ref": "#/$defs/artifactRef" },
    "launch_ref": { "$ref": "#/$defs/artifactRef" },
    "environment_ref": { "$ref": "#/$defs/artifactRef" },
    "executor": { "$ref": "#/$defs/serviceActor" },
    "provider_instance_id": { "type": "string", "minLength": 1 },
    "machine_image_id": { "type": "string", "minLength": 1 },
    "machine_image_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "id",
        "experiment_id",
        "started_at_ms",
        "completed_at_ms",
        "exit_code",
        "timed_out",
        "stdout",
        "stderr",
        "output_truncated",
        "metrics"
      ],
      "properties": {
        "schema": { "const": "ilxyr.run.v1" },
        "id": { "type": "string", "minLength": 1 },
        "experiment_id": { "type": "string", "minLength": 1 },
        "started_at_ms": { "type": "integer", "minimum": 0 },
        "completed_at_ms": { "type": "integer", "minimum": 0 },
        "exit_code": { "type": "integer" },
        "timed_out": { "type": "boolean" },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" },
        "output_truncated": { "type": "boolean" },
        "output_error": { "type": "string", "minLength": 1 },
        "metrics": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "source_attestation": {
          "$ref": "https://ilxyr.dev/schemas/retro-registration-spec.v1.json#/properties/source"
        }
      }
    },
    "run_ref": { "$ref": "#/$defs/artifactRef" },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/digestResource" }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payloadType", "payload", "signatures"],
      "properties": {
        "payloadType": {
          "enum": [
            "application/vnd.in-toto+json",
            "application/vnd.in-toto.provenance+json"
          ]
        },
        "payload": { "type": "string", "minLength": 1 },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sig"],
            "properties": {
              "keyid": { "type": "string", "minLength": 1 },
              "sig": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "reported_at_ms": { "type": "integer", "minimum": 1 }
  },
  "$defs": {
    "artifactRef": { "type": "string", "pattern": "^artifact://sha256/[a-f0-9]{64}$" },
    "serviceActor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "pattern": "^service://\\S+$" },
        "kind": { "const": "service" }
      }
    },
    "digestResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "uri", "sha256", "size_bytes"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "uri": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size_bytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
