{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ilxyr.dev/schemas/public-snapshot.v1.json",
  "title": "ilXyr public snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "source_health", "freshness", "governance", "model_lines", "experiments", "environments", "results"],
  "properties": {
    "schema": { "const": "ilxyr.public_snapshot.v1" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_path", "registry_sha256", "registry_commit", "as_of", "generated_at", "stale_after", "freshness_rule_days"],
      "properties": {
        "registry_path": { "const": "docs/lab-registry.json" },
        "registry_sha256": { "$ref": "#/$defs/digest" },
        "registry_commit": { "$ref": "#/$defs/commit" },
        "as_of": { "$ref": "#/$defs/day" },
        "generated_at": { "$ref": "#/$defs/time" },
        "stale_after": { "$ref": "#/$defs/time" },
        "freshness_rule_days": { "const": 14 }
      }
    },
    "source_health": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "status", "as_of"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["complete", "partial", "unavailable", "empty", "not_checked"] },
          "as_of": { "type": ["string", "null"] },
          "sources": { "type": "array" }
        }
      }
    },
    "freshness": { "enum": ["current_at_build", "stale"] },
    "governance": {
      "type": "object",
      "required": ["active_experiment", "system_of_record"],
      "properties": {
        "active_experiment": { "type": ["string", "null"] },
        "system_of_record": { "const": "ilxyr" }
      }
    },
    "model_lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "family", "state", "promotion_state", "active_experiment", "summary"],
        "properties": {
          "id": { "type": "string" }, "title": { "type": "string" }, "family": { "type": "string" },
          "state": { "type": "string" }, "promotion_state": { "type": "string" },
          "active_experiment": { "type": ["string", "null"] }, "summary": { "type": "string" }
        }
      }
    },
    "experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "model_line_id", "scientific_outcome", "execution_state", "disclosure_state", "lifecycle_state", "evidence_maturity", "local_import_state", "ledger_binding", "publisher_authentication", "file_integrity", "ilxyr_recorded", "summary", "source_revision", "source_repository", "url"],
        "properties": {
          "id": { "type": "string", "minLength": 1 }, "title": { "type": "string", "minLength": 1 },
          "model_line_id": { "type": "string" }, "scientific_outcome": { "type": "string" },
          "execution_state": { "type": "string" },
          "disclosure_state": { "enum": ["public", "hash_only", "withheld"] },
          "lifecycle_state": { "type": "string" },
          "evidence_maturity": { "enum": ["native", "external_public", "external_private_hash", "private_withheld"] },
          "local_import_state": { "enum": ["recorded", "pending_import", "withheld", "not_started"] },
          "ledger_binding": { "enum": ["pass", "fail", "unknown", "not_checked"] },
          "publisher_authentication": { "enum": ["pass", "fail", "unknown", "not_checked"] },
          "file_integrity": { "enum": ["pass", "fail", "unknown", "not_checked"] },
          "ilxyr_recorded": { "type": "boolean" }, "summary": { "type": "string" },
          "source_revision": { "$ref": "#/$defs/commit" }, "source_repository": { "type": "string" },
          "url": { "type": "string", "pattern": "^https://" }
        }
      }
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "operator", "state", "compatibility", "weight_classes", "network_modes", "export_policies", "manifest_ref", "conformance_ref", "verified_results", "source", "note"],
        "properties": {
          "id": { "type": "string" }, "operator": { "type": "string" },
          "state": { "type": "string" }, "compatibility": { "type": "string" },
          "weight_classes": { "type": "array", "items": { "type": "string" } },
          "network_modes": { "type": "array", "items": { "type": "string" } },
          "export_policies": { "type": "array", "items": { "type": "string" } },
          "manifest_ref": { "type": ["string", "null"] }, "conformance_ref": { "type": ["string", "null"] },
          "verified_results": { "type": "integer", "minimum": 0 },
          "source": { "type": "string", "pattern": "^https://" }, "note": { "type": "string" }
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "experiment_id", "run_ref", "environment_ref", "verification_summary_ref", "outcome", "score", "execution_state", "disclosure_state", "ledger_binding", "verification_state", "source"],
        "properties": {
          "id": { "type": "string" }, "experiment_id": { "type": "string" },
          "run_ref": { "type": "string" }, "environment_ref": { "type": "string" },
          "verification_summary_ref": { "type": "string" }, "outcome": { "type": "string" },
          "score": { "type": "number" }, "execution_state": { "type": "string" },
          "disclosure_state": { "enum": ["public", "hash_only", "withheld"] },
          "ledger_binding": { "enum": ["pass", "fail", "unknown", "not_checked"] },
          "verification_state": { "enum": ["source_reported_acceptance", "unknown"] },
          "source": { "type": "string", "pattern": "^https://" }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "day": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "time": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$" }
  }
}
